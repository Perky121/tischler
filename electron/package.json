{
  "name": "megatischler-copilot",
  "version": "1.0.0",
  "description": "MegaTischler Copilot — AI asistent za MegaTischler formule",
  "author": "Perky121",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "screenshot-desktop": "^1.12.7",
    "sharp": "^0.33.4",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.megatischler.copilot",
    "productName": "MegaTischler Copilot",
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "renderer/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MegaTischler Copilot"
    }
  }
}
