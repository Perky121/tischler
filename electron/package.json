{
  "name": "megatischler-copilot",
  "version": "1.1.1",
  "description": "MegaTischler Copilot — AI asistent za MegaTischler formule",
  "author": "Perky121",
  "main": "main.js",
  "scripts": {
    "compile": "esbuild renderer/App.jsx --bundle=false --loader:.jsx=jsx --outfile=renderer/App.js",
    "start": "npm run compile && electron .",
    "dev": "npm run compile && electron . --dev",
    "build": "npm run compile && electron-builder --win --x64",
    "build:dir": "npm run compile && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "screenshot-desktop": "^1.12.7",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "com.megatischler.copilot",
    "productName": "MegaTischler Copilot",
    "publish": null,
    "asarUnpack": [
      "node_modules/screenshot-desktop/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "!renderer/App.jsx",
      "!renderer/lib/babel.min.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "renderer/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MegaTischler Copilot",
      "artifactName": "MegaTischler-Copilot-Setup.exe"
    }
  }
}
